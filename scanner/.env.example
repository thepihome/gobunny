# GoBunnyy Job Portal Scanner
# Copy to scanner/.env and adjust for your environment.

SCANNER_PORT=8790
SCANNER_SECRET=local-dev-scanner-secret-change-in-production

# GoBunnyy Workers API (wrangler dev default)
GOBUNNY_API_URL=http://localhost:8787/api

# Optional: poll schedule settings from API every N ms (default 60000)
CONFIG_POLL_MS=60000
