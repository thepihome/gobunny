{
  "name": "gobunnyy-backend",
  "version": "1.0.0",
  "description": "Backend API for GoBunnyy",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "setup-db": "node setup-db.js",
    "create-admin": "node create-admin.js",
    "migrate:job-classification": "node migrate-add-job-classification.js",
    "migrate:candidate-classification": "node migrate-candidate-job-classification.js",
    "test": "node --test 'src/**/__tests__/**/*.test.mjs'",
    "test:watch": "node --test --watch 'src/**/__tests__/**/*.test.mjs'",
    "db:seed-local-admin": "npx wrangler d1 execute godashdevcore01 --local --env dev --file=./database/scripts/seed-local-admin.sql"
  },
  "dependencies": {
    "express": "^4.18.2",
    "pg": "^8.11.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "multer": "^1.4.5-lts.1",
    "express-validator": "^7.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}

